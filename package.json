{
	"name": "svelte-time-range",
	"version": "0.1.2",
	"description": "A zoomable, time-zone aware time range slider for Svelte 5 with presets, snapping and an optional chart",
	"author": "elebree",
	"license": "MIT",
	"homepage": "https://elebree.github.io/svelte-time-range/",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/elebree/svelte-time-range.git"
	},
	"bugs": {
		"url": "https://github.com/elebree/svelte-time-range/issues"
	},
	"keywords": [
		"svelte",
		"svelte5",
		"sveltekit",
		"svelte-component",
		"time-range",
		"date-range",
		"range-slider",
		"timeline",
		"time-picker",
		"time-zone",
		"histogram"
	],
	"type": "module",
	"packageManager": "pnpm@12.15.0",
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"sideEffects": [
		"**/*.css"
	],
	"types": "./dist/index.d.ts",
	"svelte": "./dist/index.js",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		}
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && pnpm run package",
		"package": "svelte-kit sync && svelte-package && publint",
		"prepack": "pnpm run package",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo \"\"",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "vitest run && playwright test",
		"test:unit": "vitest",
		"test:e2e": "playwright test",
		"test:coverage": "vitest run --coverage"
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/package": "^2.5.8",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/node": "^24",
		"@vitest/browser-playwright": "^4.1.8",
		"@vitest/coverage-v8": "4.1.12",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"playwright": "^1.60.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"publint": "^0.3.21",
		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.3.0",
		"vitest": "^4.1.8",
		"vitest-browser-svelte": "^2.1.1"
	}
}
